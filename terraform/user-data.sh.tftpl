#!/bin/bash

set -e

apt-get update -y

apt-get install -y curl git

curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs

node --version
npm --version

cd /home/ubuntu

git clone https://github.com/Vaaniv41/nodejs_CRUD_API_practice.git app

cd /home/ubuntu/app

npm install

npm run build

npm install -g pm2

pm2 start dist/main.js --name nestjs-app

pm2 save

pm2 startup systemd -u ubuntu --hp /home/ubuntu